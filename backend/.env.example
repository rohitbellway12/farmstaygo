NODE_ENV=development
PORT=5000
BACKEND_URL=http://localhost:5000
WEBSITE_URL=http://localhost:3000
PORTAL_URL=http://localhost:5173

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
JWT_SECRET=change-this-to-a-long-random-secret

# Calendar sync interval in milliseconds (default: 1800000 = 30 minutes)
CALENDAR_SYNC_INTERVAL=1800000

STORAGE_PATH=storage/public
INVOICE_OUTPUT_DIR=storage/invoices
# Optional: only set this if invoice PDFs are served from a public static/CDN URL.
# PUBLIC_STORAGE_URL=https://api.example.com/storage

MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_ENCRYPTION=tls

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

VENDOR_EMAIL=vendor@example.com
VENDOR_PASSWORD=change-me
VENDOR_MOBILE=9999999999
VENDOR_BUSINESS_NAME=Demo Farm Stay
VENDOR_FIRST_NAME=Demo
VENDOR_LAST_NAME=Vendor
