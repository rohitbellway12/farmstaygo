generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  VENDOR
  ADMIN
  STAFF_ADMIN
  SUPPORT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum KycStatus {
  NOT_SUBMITTED
  PENDING
  APPROVED
  REJECTED
}

model User {
  id             Int        @id @default(autoincrement())
  firstName      String     @map("first_name")
  lastName       String?    @map("last_name")
  email          String     @unique
  mobile         String?    @unique
  password       String
  role           UserRole   @default(USER)
  status         UserStatus @default(ACTIVE)
  emailVerified  Boolean    @default(false) @map("email_verified")
  mobileVerified Boolean    @default(false) @map("mobile_verified")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  vendor Vendor?
  wishlists Wishlist[]
  bookings Booking[]

  @@map("users")
}

model Vendor {
  id                 Int       @id @default(autoincrement())
  userId             Int       @unique @map("user_id")
  businessName       String    @map("business_name")
  kycStatus          KycStatus @default(NOT_SUBMITTED) @map("kyc_status")
  panNumber          String?   @map("pan_number")
  aadhaarNumber      String?   @map("aadhaar_number")
  addressLine        String?   @map("address_line")
  city               String?
  state              String?
  postalCode         String?   @map("postal_code")
  bankAccountName    String?   @map("bank_account_name")
  bankAccountNumber  String?   @map("bank_account_number")
  bankIfscCode       String?   @map("bank_ifsc_code")
  gstNumber          String?   @map("gst_number")
  kycSubmittedAt     DateTime? @map("kyc_submitted_at")
  kycReviewedAt      DateTime? @map("kyc_reviewed_at")
  kycRejectionReason String?   @map("kyc_rejection_reason")
  commissionRate     Decimal?  @map("commission_rate") @db.Decimal(5, 2)
  totalEarnings      Decimal?  @default(0) @map("total_earnings") @db.Decimal(12, 2)
  totalCommission    Decimal?  @default(0) @map("total_commission") @db.Decimal(12, 2)
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  properties Property[]
  commissions VendorCommission[]

  @@map("vendors")
}

model VendorCommission {
  id              String    @id @default(cuid())
  vendorId        Int       @map("vendor_id")
  bookingId       String    @map("booking_id")
  bookingAmount   Decimal   @db.Decimal(12, 2) @map("booking_amount")
  commissionRate  Decimal   @db.Decimal(5, 2) @map("commission_rate")
  commissionAmount Decimal  @db.Decimal(12, 2) @map("commission_amount")
  vendorEarning   Decimal   @db.Decimal(12, 2) @map("vendor_earning")
  status          CommissionStatus @default(PENDING) @map("status")
  paidAt          DateTime? @map("paid_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  vendor  Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  booking Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([vendorId, status])
  @@index([bookingId])
  @@map("vendor_commissions")
}

enum CommissionStatus {
  PENDING
  PAID
  CANCELLED
}

model PropertyCategory {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  icon        String?
  image       String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  properties Property[]

  @@index([isActive, sortOrder])
}

model ServiceCity {
  id        String   @id @default(cuid())
  name      String
  state     String
  country   String   @default("India")
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, state, country])
  @@index([isActive, sortOrder])
  @@map("service_cities")
}

model CmsPage {
  id              String   @id @default(cuid())
  title           String
  slug            String   @unique
  pageType        String   @map("page_type")
  excerpt         String?
  content         String
  metaTitle       String?  @map("meta_title")
  metaDescription String?  @map("meta_description")
  isPublished     Boolean  @default(false) @map("is_published")
  showInFooter    Boolean  @default(true) @map("show_in_footer")
  footerGroup     String   @default("company") @map("footer_group")
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([isPublished, showInFooter, footerGroup, sortOrder])
  @@index([pageType])
  @@map("cms_pages")
}

/**
 * |--------------------------------------------------------------------------
 * | Blog Posts
 * |--------------------------------------------------------------------------
 */

model BlogPost {
  id              String   @id @default(cuid())
  title           String
  slug            String   @unique
  excerpt         String?
  description     String?
  content         String
  imageUrl        String?  @map("image_url")
  metaTitle       String?  @map("meta_title")
  metaDescription String?  @map("meta_description")
  metaKeywords    String?  @map("meta_keywords")
  isPublished     Boolean  @default(false) @map("is_published")
  author          String?
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([isPublished, sortOrder])
  @@map("blog_posts")
}

/**
 * |--------------------------------------------------------------------------
 * | Amenity Groups
 * |--------------------------------------------------------------------------
 */

enum AmenityGroup {
  POPULAR
  BASIC
  OUTDOOR
  INDOOR
  SAFETY
  KITCHEN
  ENTERTAINMENT
  ACCESSIBILITY
}

/**
 * |--------------------------------------------------------------------------
 * | Property Booking Types
 * |--------------------------------------------------------------------------
 */

enum PropertyBookingType {
  ENTIRE_PROPERTY
  ROOM_WISE
  BOTH
}

/**
 * |--------------------------------------------------------------------------
 * | Property Status
 * |--------------------------------------------------------------------------
 */

enum PropertyStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  INACTIVE
  SUSPENDED
}

enum BookingMode {
  ENTIRE_PROPERTY
  ROOM_WISE
}

enum BookingStatus {
  REQUESTED
  CONFIRMED
  CANCELLED
  REJECTED
  COMPLETED
}

enum PaymentMethod {
  ONLINE
  CASH
  BANK_TRANSFER
}

enum PaymentType {
  RESERVATION
  INSTALLMENT
  BALANCE
  REFUND
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

/**
 * |--------------------------------------------------------------------------
 * | Property Amenities
 * |--------------------------------------------------------------------------
 */

model Amenity {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  description String?
  icon        String?
  image       String?
  group       AmenityGroup @default(BASIC)
  isActive    Boolean      @default(true)
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  propertyAmenities PropertyAmenity[]
  roomAmenities     RoomAmenity[]

  @@index([group, isActive, sortOrder])
}

/**
 * |--------------------------------------------------------------------------
 * | Properties
 * |--------------------------------------------------------------------------
 */

model Property {
  id         String @id @default(cuid())
  vendorId   Int
  categoryId String

  /**
   * |--------------------------------------------------------------------------
   * | Basic Information
   * |--------------------------------------------------------------------------
   */

  title            String
  slug             String              @unique
  shortDescription String?
  description      String?
  bookingType      PropertyBookingType
  status           PropertyStatus      @default(DRAFT)

  /**
   * |--------------------------------------------------------------------------
   * | Property Capacity
   * |--------------------------------------------------------------------------
   */

  maxGuests  Int?
  bedrooms   Int?
  bathrooms  Int?
  beds       Int?
  totalRooms Int?

  /**
   * |--------------------------------------------------------------------------
   * | Property Location
   * |--------------------------------------------------------------------------
   */

  addressLine1 String?
  addressLine2 String?
  landmark     String?
  locality     String?
  city         String?
  state        String?
  country      String   @default("India")
  postalCode   String?
  latitude     Decimal? @db.Decimal(10, 7)
  longitude    Decimal? @db.Decimal(10, 7)

  /**
   * |--------------------------------------------------------------------------
   * | Pricing
   * |--------------------------------------------------------------------------
   */

  basePrice       Decimal? @db.Decimal(12, 2)
  weekendPrice    Decimal? @db.Decimal(12, 2)
  cleaningFee     Decimal? @db.Decimal(12, 2)
  securityDeposit Decimal? @db.Decimal(12, 2)
  reservationAmount Decimal? @db.Decimal(12, 2) @map("reservation_amount")

  /**
   * |--------------------------------------------------------------------------
   * | Stay Information
   * |--------------------------------------------------------------------------
   */

  checkInTime  String?
  checkOutTime String?
  minimumStay  Int     @default(1)
  instantBook  Boolean @default(false)

  /**
   * |--------------------------------------------------------------------------
   * | Administration
   * |--------------------------------------------------------------------------
   */

  rejectionReason String?
  isFeatured      Boolean   @default(false)
  submittedAt     DateTime?
  approvedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  /**
   * |--------------------------------------------------------------------------
   * | Relationships
   * |--------------------------------------------------------------------------
   */

  vendor             Vendor                      @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  category           PropertyCategory            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  amenities          PropertyAmenity[]
  images             PropertyImage[]
  roomTypes          RoomType[]
  availabilityBlocks PropertyAvailabilityBlock[]
  bookings           Booking[]
  wishlists          Wishlist[]

  @@index([vendorId, status])
  @@index([categoryId, status])
  @@index([city, status])
  @@index([status, createdAt])
}

/**
 * |--------------------------------------------------------------------------
 * | Property Amenities
 * |--------------------------------------------------------------------------
 * |
 * | This table connects properties with their selected amenities.
 * |
 */

model PropertyAmenity {
  propertyId String
  amenityId  String
  createdAt  DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  amenity  Amenity  @relation(fields: [amenityId], references: [id], onDelete: Restrict)

  @@id([propertyId, amenityId])
  @@index([amenityId])
}

/**
 * |--------------------------------------------------------------------------
 * | Property Images
 * |--------------------------------------------------------------------------
 * |
 * | Each property can contain one cover image and multiple gallery images.
 * | Images are stored separately for ordering and management.
 * |
 */

model PropertyImage {
  id         String   @id @default(cuid())
  propertyId String
  image      String
  altText    String?
  isCover    Boolean  @default(false)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, sortOrder])
  @@index([propertyId, isCover])
}

/**
 * |--------------------------------------------------------------------------
 * | Room Types
 * |--------------------------------------------------------------------------
 * |
 * | A Room Type represents a bookable category inside a ROOM_WISE or BOTH
 * | property. Multiple identical physical rooms are managed using totalRooms.
 * |
 * | Example:
 * | Deluxe Room - Total Quantity: 5
 * |
 */

model RoomType {
  id         String @id @default(cuid())
  propertyId String

  /**
   * |--------------------------------------------------------------------------
   * | Basic Information
   * |--------------------------------------------------------------------------
   */

  name        String
  slug        String
  description String?

  /**
   * |--------------------------------------------------------------------------
   * | Room Inventory
   * |--------------------------------------------------------------------------
   */

  totalRooms Int @default(1)

  /**
   * |--------------------------------------------------------------------------
   * | Guest Capacity
   * |--------------------------------------------------------------------------
   */

  maxAdults   Int @default(1)
  maxChildren Int @default(0)
  maxGuests   Int @default(1)
  beds        Int @default(1)
  bathrooms   Int @default(1)

  /**
   * |--------------------------------------------------------------------------
   * | Pricing
   * |--------------------------------------------------------------------------
   * |
   * | Prices are stored per room per night.
   * |
   */

  basePrice    Decimal  @db.Decimal(12, 2)
  weekendPrice Decimal? @db.Decimal(12, 2)
  reservationAmount Decimal? @db.Decimal(12, 2) @map("reservation_amount")

  /**
   * |--------------------------------------------------------------------------
   * | Management
   * |--------------------------------------------------------------------------
   */

  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /**
   * |--------------------------------------------------------------------------
   * | Relationships
   * |--------------------------------------------------------------------------
   */

  property           Property                @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  amenities          RoomAmenity[]
  images             RoomImage[]
  availabilityBlocks RoomAvailabilityBlock[]
  bookings           Booking[]

  /**
   * Same room slug can be used in different properties,
   * but it must remain unique inside one property.
   */

  @@unique([propertyId, slug])
  @@index([propertyId, isActive, sortOrder])
  @@index([propertyId, createdAt])
}

/**
 * |--------------------------------------------------------------------------
 * | Room Amenities
 * |--------------------------------------------------------------------------
 * |
 * | Connects Room Types with the existing Amenities master.
 * |
 */

model RoomAmenity {
  roomTypeId String
  amenityId  String
  createdAt  DateTime @default(now())

  roomType RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  amenity  Amenity  @relation(fields: [amenityId], references: [id], onDelete: Restrict)

  @@id([roomTypeId, amenityId])
  @@index([amenityId])
}

/**
 * |--------------------------------------------------------------------------
 * | Room Images
 * |--------------------------------------------------------------------------
 * |
 * | Each Room Type can contain one cover image and multiple gallery images.
 * |
 */

model RoomImage {
  id         String   @id @default(cuid())
  roomTypeId String
  image      String
  altText    String?
  isCover    Boolean  @default(false)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  roomType RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  @@index([roomTypeId, sortOrder])
  @@index([roomTypeId, isCover])
}

/**
 * |--------------------------------------------------------------------------
 * | Property Availability Blocks
 * |--------------------------------------------------------------------------
 * |
 * | Default rule:
 * |
 * | If no record exists for a date, the property is available.
 * |
 * | A record in this table means that the complete property is manually
 * | blocked for that night.
 * |
 * | This model is used for:
 * |
 * | ENTIRE_PROPERTY
 * | BOTH
 * |
 */

model PropertyAvailabilityBlock {
  id         String   @id @default(cuid())
  propertyId String
  date       DateTime @db.Date
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, date])
  @@index([date])
}

/**
 * |--------------------------------------------------------------------------
 * | Room Availability Blocks
 * |--------------------------------------------------------------------------
 * |
 * | Stores the number of rooms manually removed from availability for one
 * | Room Type and one date.
 * |
 * | Example:
 * |
 * | Deluxe Room total inventory: 5
 * | Manual blocked rooms: 2
 * | Available inventory: 3
 * |
 * | This model is used for:
 * |
 * | ROOM_WISE
 * | BOTH
 * |
 */

model RoomAvailabilityBlock {
  id           String   @id @default(cuid())
  roomTypeId   String
  date         DateTime @db.Date
  blockedRooms Int
  note       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  roomType RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  @@unique([roomTypeId, date])
  @@index([date])
}

model Wishlist {
  id         String   @id @default(cuid())
  userId     Int      @map("user_id")
  propertyId String   @map("property_id")
  createdAt  DateTime @default(now()) @map("created_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
  @@index([userId])
  @@index([propertyId])
}

model Booking {
  id            String        @id @default(cuid())
  userId        Int           @map("user_id")
  propertyId    String        @map("property_id")
  roomTypeId    String?       @map("room_type_id")
  bookingMode   BookingMode   @map("booking_mode")
  status        BookingStatus @default(REQUESTED)
  checkIn       DateTime      @map("check_in") @db.Date
  checkOut      DateTime      @map("check_out") @db.Date
  guests        Int
  rooms         Int           @default(1)
  totalNights   Int           @map("total_nights")
  estimatedTotal Decimal?     @map("estimated_total") @db.Decimal(12, 2)
  currency      String        @default("INR")
  guestName     String        @map("guest_name")
  guestEmail    String        @map("guest_email")
  guestMobile   String?       @map("guest_mobile")
  specialRequest String?      @map("special_request")
  reservationAmount Decimal?  @db.Decimal(12, 2) @map("reservation_amount")
  paymentStatus  String       @default("PENDING") @map("payment_status")
  adminCommission Decimal?   @map("admin_commission") @db.Decimal(12, 2)
  vendorCommission Decimal?  @map("vendor_commission") @db.Decimal(12, 2)
  acceptedAt     DateTime?    @map("accepted_at")
  rejectedAt     DateTime?    @map("rejected_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  roomType RoomType? @relation(fields: [roomTypeId], references: [id], onDelete: SetNull)
  payments Payment[]
  commissions VendorCommission[]

  @@index([userId, status])
  @@index([propertyId, status, checkIn, checkOut])
  @@index([roomTypeId, status, checkIn, checkOut])
  @@map("bookings")
}

model Payment {
  id            String        @id @default(cuid())
  bookingId     String        @map("booking_id")
  amount        Decimal       @db.Decimal(12, 2)
  paymentMethod PaymentMethod @map("payment_method")
  paymentType   PaymentType   @map("payment_type")
  status        PaymentStatus @default(PENDING)
  transactionId String?       @map("transaction_id")
  notes         String?
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@map("payments")
}

enum NotificationType {
  BOOKING
  PAYMENT
  REFUND
  SYSTEM
}

enum NotificationRecipientType {
  USER
  VENDOR
  ADMIN
}

model Notification {
  id                 String                @id @default(cuid())
  recipientType      NotificationRecipientType @map("recipient_type")
  recipientId        Int                   @map("recipient_id")
  actorId            Int                   @map("actor_id")
  type               NotificationType      @default(SYSTEM)
  entityType         String?               @map("entity_type")
  entityId           String?               @map("entity_id")
  title              String
  message            String
  isRead             Boolean               @default(false) @map("is_read")
  readAt             DateTime?             @map("read_at")
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")
  metadata           String?               @map("metadata")

  @@index([recipientType, recipientId, isRead])
  @@index([recipientType, recipientId, createdAt])
  @@map("notifications")
}
